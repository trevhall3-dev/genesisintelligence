{
  "name": "genesisintelligence",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-02",
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genesis-intelligence-db",
      "database_id": "ce5064b8-96ea-4729-ab47-3bd78da05cea"
    }
  ]
}
